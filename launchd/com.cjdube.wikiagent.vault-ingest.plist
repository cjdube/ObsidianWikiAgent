<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cjdube.wikiagent.[vault]-ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>~/Projects/ObsidianWikiAgent/.venv/bin/python</string>
        <string>~/Projects/ObsidianWikiAgent/wiki_ingest.py</string>
        <string>--vault</string>
        <string>~/Documents/llm-wiki-[vault]</string>
    </array>

    <key>WorkingDirectory</key>
    <string>~/Projects/ObsidianWikiAgent</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>~/Projects/ObsidianWikiAgent/logs/[vault]-ingest.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>~/Projects/ObsidianWikiAgent/logs/[vault]-ingest.launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
