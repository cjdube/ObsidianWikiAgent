# Which backend the agent loop talks to: ollama (default) or gemini.
# Scheduled ingests leave this unset and run locally; set it per-run for
# one-off bulk work, e.g. LLM_PROVIDER=gemini python wiki_ingest.py ...
# — or per-job, in one plist's EnvironmentVariables, which is how a weekly
# lint gets a better judgment pass without the daily ingests leaving the box.
# Keep it commented here: this file is read by every job, so setting it means
# setting it for all of them. Real env vars win over this file either way.
# LLM_PROVIDER=ollama

# Ollama. Must be a tag `ollama list` actually prints — a bare family name
# resolves to nothing. Must also support tool calling; the ingest is all tool
# calls, so a model without it fails every run.
OLLAMA_MODEL=gemma4:26b-mlx
OLLAMA_HOST=http://localhost:11434
# Seconds to wait on one model call (default 300). A large vault makes every
# call that reads the index a big-prefill call, and on a local model that can
# outrun 300s — the retry recovers, but each timeout costs the full wait.
OLLAMA_TIMEOUT=600
# Context window for one call (code default 32768). Must hold the vault's
# RULES.md, plus every tool result the loop accumulates: the source, each page
# read, and each page written. Overflow is silent — Ollama drops the oldest
# messages and the answers just get worse — so raise this as the vault grows.
# For scale, a 336-page vault measures ~3.3k tokens of RULES.md and ~0.4k per
# page read, which leaves 32768 comfortable but not roomy. You do not have to
# guess at the moment it stops being enough: the run logs a warning when the
# opening prompt alone fills half the window. Treat that as the cue to raise it.
OLLAMA_NUM_CTX=32768
# Longest reply the model may write, in tokens (code default 2000). Ollama's
# own default is unlimited, which means a repetition loop generates until the
# client gives up — one such call burned a whole 45-minute run in four 10-minute
# timeouts. A step here is a tool call or a page write, so 2000 is generous.
# A reply that stops at this cap logs a WARNING; truncation is never silent.
OLLAMA_NUM_PREDICT=2000

# Wall-clock budget for one whole wiki_ingest run, in minutes (default 45).
# A run that overruns is holding the only Ollama slot (OLLAMA_NUM_PARALLEL=1)
# that every other consumer on the box is queued behind, so it stops, exits
# non-zero, and leaves the unprocessed sources for tomorrow's run.
WIKI_RUN_BUDGET_MINUTES=45

# Failure push (ntfy). Unset = push switched off; jobs still log and still
# exit non-zero. Same self-hosted server as LocalLLMAgent's alerts.
NTFY_URL=
NTFY_TOKEN=

# Gemini — only needed when LLM_PROVIDER=gemini.
# List the model ids your key can reach: python -m agent.loop list-models
GEMINI_API_KEY=
GEMINI_MODEL=
