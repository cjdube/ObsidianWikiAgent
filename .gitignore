.venv/
__pycache__/
config/.env
# Written by launchd/reload-after-upgrade.sh: the identity of the interpreter
# the jobs exec, so a brew upgrade that swaps it is caught before a run dies on
# it rather than after. Per-machine by definition.
config/.interpreter_id
# The trailing * matters: RotatingFileHandler names its backups .log.1, .log.2,
# which `logs/*.log` does not match. Those backups hold every tool call's full
# JSON result — i.e. verbatim raw-source and wiki-page content — so leaving them
# trackable puts private vault content one `git add -A` away from a commit.
logs/*.log*
.DS_Store

# Personal launchd jobs — concrete paths/labels stay local. Copy
# launchd/template.plist.txt to make your own; the template is tracked.
launchd/*.plist

# Claude Code local state: per-machine permissions, scratch worktrees. Only a
# machine-global ignore was covering these, which doesn't survive a clone.
.claude/
